# ==========================================
# 🔒 Vamserlike 테스트 환경 변수 (.env.example)
# ==========================================
# 사용법: 이 파일을 .env 로 복사한 뒤 실제 값을 채우세요.
#   cp .env.example .env
#
# ⚠️ .env 는 절대 Git에 올리지 마세요! (.gitignore 에 .env 포함 확인)
# 위치: 프로젝트 루트 (config.py 와 같은 폴더)
# ==========================================

# 실행 환경: local / cloud
ENV=local

# 클라우드 배포 시 서버 주소 (ENV=cloud 일 때 사용)
CLOUD_URL=http://43.201.49.116:5159

# --- AWS Cognito ---
AWS_REGION=ap-northeast-2
USER_POOL_ID=ap-northeast-2_XXXXXXXXX
COGNITO_CLIENT_ID=your_client_id_here

# --- 테스트 공통 ---
TEST_PW=Password123!
USER_PREFIX=loadtest_user_
USER_COUNT=1000

# --- DynamoDB ---
TABLE_NAME=VamserlikeGame
PARTITION_KEY=UserId

# --- 캐릭터 해금 테스트 (v3) ---
# appsettings.json 의 GameOptions:CharacterUnlockCosts 에 등록된
# '비용 1 이상' 캐릭터 ID 를 지정하세요.
UNLOCK_TARGET_CHARACTER_ID=rice_farmer

# --- Dev 리셋 확인 문구 (v3) ---
# DevController 의 하드코딩 값과 반드시 일치해야 함
RESET_CONFIRM_TEXT=DELETE_TEST_DATA

# --- 부하 테스트 (locust) ---
# 응답 시간 임계값 (ms). 초과 시 실패로 마킹
THRESHOLD_MS=3000

# 분산 모드 Worker 실행 시에만 설정 (단일 실행 시 주석 유지)
# WORKER_INDEX=0
# WORKER_TOTAL=4
